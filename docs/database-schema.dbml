// Cloud backend database (Cloudflare D1, SQLite). Source of truth: server/migrations/*.sql
// Timestamps are epoch milliseconds.

Table users {
  id text [pk, note: 'UUID']
  email text [not null, unique, note: 'lowercased; login is by magic link, no password']
  display_name text [note: 'shown on the leaderboard, 2-24 chars']
  created_at integer [not null]
}

Table login_tokens {
  token_hash text [pk, note: 'SHA-256 of the one-use token sent by email']
  email text [not null]
  expires_at integer [not null, note: '15 minutes']
  used_at integer [note: 'set when redeemed; a token works once']
  created_at integer [not null]

  indexes {
    (email, created_at) [name: 'idx_login_tokens_email', note: 'rate limit: 3 links per email every 15 min']
  }
}

Table sessions {
  token_hash text [pk, note: 'SHA-256 of the bearer token']
  user_id text [not null, ref: > users.id]
  expires_at integer [not null, note: '90 days']
  created_at integer [not null]

  indexes {
    user_id [name: 'idx_sessions_user']
  }
}

Table saves {
  user_id text [not null, ref: > users.id]
  slot text [not null, note: "'run' (run in progress) | 'profile'"]
  data text [note: 'JSON; NULL = deleted (tombstone keeps the revision)']
  revision integer [not null, note: 'compare-and-swap counter for multi-device sync']
  updated_at integer [not null]

  indexes {
    (user_id, slot) [pk]
  }
}

Table runs {
  id text [pk, note: 'UUID generated by the client: uploads are idempotent']
  user_id text [not null, ref: > users.id]
  hero_class text [not null, note: 'druida | barbaro | mago | picaro | brujo | paladin']
  result text [not null, note: "'victory' | 'defeat'"]
  dm_defeated integer [not null, default: 0, note: 'true ending: the Dungeon Master fell; ranks above any victory']
  chapter integer [not null]
  floor integer [not null]
  turns integer [not null]
  seed integer [not null]
  game_version text [not null]
  stats text [note: 'JSON EstadisticasRun, max 8 KB']
  created_at integer [not null]

  indexes {
    (user_id, created_at) [name: 'idx_runs_user']
    (hero_class, result, chapter, floor, turns) [name: 'idx_runs_leaderboard']
  }
}
