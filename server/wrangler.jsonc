{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "dracs-rogues-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-01",
  "observability": { "enabled": true },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "dracs-rogues",
      "database_id": "32055969-e7fb-43ae-907f-b9e7fd1feadd",
      "migrations_dir": "migrations"
    }
  ],
  "vars": {
    // Where the game lives: magic links point here.
    "APP_URL": "https://sergiowonder.github.io/mazos-y-mazmorras/",
    // Comma-separated origins allowed by CORS.
    "ALLOWED_ORIGINS": "https://sergiowonder.github.io,http://localhost:5173,http://localhost:4173",
    "EMAIL_FROM": "Dracs & Rogues <no-reply@morghur.es>"
  }
  // Secrets (wrangler secret put): RESEND_API_KEY (Infisical SergioAlvarez/RESEND_API_TOKEN, send-only key).
  // Without it, magic links are only logged (local dev).
}
