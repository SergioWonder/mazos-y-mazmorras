{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "dracs-rogues-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-01",
  "observability": { "enabled": true },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "dracs-rogues",
      "database_id": "32055969-e7fb-43ae-907f-b9e7fd1feadd",
      "migrations_dir": "migrations"
    }
  ],
  "durable_objects": {
    "bindings": [
      // Per-user inbox: live alerts over WebSocket, Web Push when nobody is connected.
      { "name": "BUZON", "class_name": "Buzon" },
      // Per-game room: relays and logs the players' entries.
      { "name": "SALA", "class_name": "Sala" }
    ]
  },
  "migrations": [{ "tag": "v1-multiplayer", "new_sqlite_classes": ["Buzon", "Sala"] }],
  "vars": {
    // Web Push: public VAPID key (see server/README.md). Empty = push disabled.
    "VAPID_PUBLIC_KEY": "",
    "VAPID_SUBJECT": "mailto:no-reply@morghur.es",
    // Where the game lives: magic links point here.
    "APP_URL": "https://dracs-and-rogues.morghur.es/",
    // Comma-separated origins allowed by CORS.
    "ALLOWED_ORIGINS": "https://dracs-and-rogues.morghur.es,https://dracs-and-rogues.sergiowonder.workers.dev,https://sergiowonder.github.io,http://localhost:5173,http://localhost:4173",
    "EMAIL_FROM": "Dracs & Rogues <no-reply@morghur.es>"
  }
  // Secrets (wrangler secret put): VAPID_PRIVATE_KEY (Web Push), RESEND_API_KEY (Infisical SergioAlvarez/RESEND_API_TOKEN, send-only key).
  // Without it, magic links are only logged (local dev).
}
