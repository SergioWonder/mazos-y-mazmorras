    "deploy": "wrangler deploy"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.5.0",
    "@cloudflare/workers-types": "^5.20261103.1",
    "typescript": "~5.6.2",
    "vitest": "~4.1.0",
    "wrangler": "^4.156.2"
  },
  "allowScripts": {
    "workerd@1.20260815.1": true,
    "workerd@1.20261102.1": true,
    "esbuild@0.28.1": true,
    "esbuild@0.28.2": true
  },
  "dependencies": {
    "hono": "^4.13.16"
  }
}
